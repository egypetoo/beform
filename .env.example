GOOGLE_SHEET_WEBHOOK=
# Required in production. Auto-persisted to data/flask_secret.txt if empty.
FLASK_SECRET_KEY=change-this-to-a-long-random-value
SHEET_SECRET=change-this-to-a-long-random-value
SESSION_COOKIE_SECURE=1
MANAGER_LOGIN_PATH=/be-review-k4n
# Prefer a werkzeug hash (pbkdf2:...). Plaintext is migrated once into data/hr_password.hash
MANAGER_HR_PASSWORD=
MANAGER_HR_PASSWORD_HASH=

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# Leave empty to disable CAPTCHA locally. Set both on production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
